{
  "manifest_version": 3,
  "name": "Tab Reload Timer",
  "version": "1.0.0",
  "description": "Automatically reload individual Safari tabs at an interval you choose.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "permissions": ["alarms", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "64": "icon-64.png"
    },
    "default_title": "Tab Reload Timer",
    "default_popup": "popup.html"
  }
}
